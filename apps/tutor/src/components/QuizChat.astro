---
import type { Page } from '../lib/content';
import Avatar from './Avatar.astro';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const { quiz } = page;
const config = JSON.stringify({
  locale: page.locale,
  currency: page.currency,
  quiz,
  pricing: {
    ...page.pricing,
    courses: page.courses.map(({ id, price }) => ({ id, price })),
  },
  courseNames: Object.fromEntries(page.courses.map((course) => [course.id, course.name])),
});
const first = quiz.questions.goal;
const initials = page.locale === 'ru' ? 'АМ' : 'AM';
---

<div class="quiz rounded-[var(--radius-card)] bg-white shadow-card" data-quiz={config}>
  <div class="flex items-center gap-3 border-b border-line px-5 py-4">
    <Avatar initials={initials} />
    <div class="leading-tight">
      <p class="font-display font-extrabold">{quiz.title}</p>
      <p class="mt-0.5 flex items-center gap-1.5 text-sm text-muted">
        <span class="size-2 rounded-full bg-good" aria-hidden="true"></span>
        {page.site.name}, {quiz.status}
      </p>
    </div>
  </div>

  <div
    class="quiz-log flex flex-col gap-2.5 overflow-y-auto px-4 py-5 sm:px-5"
    role="log"
    aria-live="polite"
    data-quiz-log
  >
    <p class="bubble bubble-in">{quiz.greeting}</p>
    <p class="bubble bubble-in" data-question="goal">
      {first.text}
    </p>
  </div>

  <div class="border-t border-line px-4 py-4 sm:px-5">
    <div class="flex flex-wrap gap-2" role="group" aria-label={first.text} data-quiz-options>
      {Object.entries(first.options).map(([value, label]) => (
        <button type="button" class="option" data-value={value}>
          {label}
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  import { setLeadContext } from '@landings/ui/scripts/lead-context';
  import { trackGoal } from '@landings/ui/scripts/analytics';
  import {
    nextStep,
    recommend,
    type Answers,
    type CourseId,
    type Pricing,
    type StepId,
  } from '../lib/quiz';

  interface QuizConfig {
    locale: 'ru' | 'en';
    currency: 'RUB' | 'USD';
    pricing: Pricing;
    courseNames: Record<CourseId, string>;
    quiz: {
      questions: Record<StepId, { text: string; options: Record<string, string> }>;
      result: {
        intro: string;
        price: string;
        perWeek: string[];
        adjusted: string;
        cta: string;
        restart: string;
      };
      summary: string;
      greeting: string;
    };
  }

  const root = document.querySelector<HTMLElement>('[data-quiz]');
  if (root) {
    const config = JSON.parse(root.dataset.quiz ?? '{}') as QuizConfig;
    const log = root.querySelector<HTMLElement>('[data-quiz-log]');
    const optionsBox = root.querySelector<HTMLElement>('[data-quiz-options]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const money = new Intl.NumberFormat(config.locale === 'ru' ? 'ru-RU' : 'en-US', {
      style: 'currency',
      currency: config.currency,
      maximumFractionDigits: 0,
    });
    let answers: Answers = {};
    let started = false;

    const fill = (template: string, values: Record<string, string>) =>
      template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? '');

    const bubble = (text: string, side: 'in' | 'out') => {
      const el = document.createElement('p');
      el.className = `bubble bubble-${side} bubble-new`;
      el.textContent = text;
      log?.append(el);
      if (log) log.scrollTop = log.scrollHeight;
      return el;
    };

    const typing = () =>
      new Promise<void>((resolve) => {
        if (reduced) return resolve();
        const dots = document.createElement('p');
        dots.className = 'bubble bubble-in typing';
        dots.setAttribute('aria-hidden', 'true');
        dots.innerHTML = '<span></span><span></span><span></span>';
        log?.append(dots);
        if (log) log.scrollTop = log.scrollHeight;
        setTimeout(() => {
          dots.remove();
          resolve();
        }, 550);
      });

    const button = (label: string, className: string, onClick: () => void) => {
      const el = document.createElement('button');
      el.type = 'button';
      el.className = className;
      el.textContent = label;
      el.addEventListener('click', onClick);
      return el;
    };

    const showOptions = (step: StepId, focus = true) => {
      if (!optionsBox) return;
      const question = config.quiz.questions[step];
      optionsBox.setAttribute('aria-label', question.text);
      optionsBox.replaceChildren(
        ...Object.entries(question.options).map(([value, label]) =>
          button(label, 'option', () => void answer(step, value, label)),
        ),
      );
      if (focus) optionsBox.querySelector('button')?.focus({ preventScroll: true });
    };

    const showResult = () => {
      const result = recommend(answers, config.pricing);
      const course = config.courseNames[result.course];
      const perWeek = config.quiz.result.perWeek[result.perWeek - 1] ?? '';
      bubble(fill(config.quiz.result.intro, { course }), 'in');
      if (result.adjusted) bubble(config.quiz.result.adjusted, 'in');
      const price = fill(config.quiz.result.price, {
        perWeek,
        lesson: money.format(result.lessonPrice),
        monthly: money.format(result.monthly),
      });
      bubble(price.charAt(0).toUpperCase() + price.slice(1), 'in');
      trackGoal('quiz_complete', { course: result.course });

      // Labels go to the CRM as the visitor saw them.
      const q = config.quiz.questions;
      const context: Record<string, string> = { source: 'Квиз', course };
      if (answers.goal) context.goal = q.goal.options[answers.goal] ?? answers.goal;
      if (answers.exam) context.level = q.exam.options[answers.exam] ?? answers.exam;
      if (answers.level) context.level = q.level.options[answers.level] ?? answers.level;
      context.format = [answers.format ? q.format.options[answers.format] : '', perWeek]
        .filter(Boolean)
        .join(', ');

      optionsBox?.replaceChildren(
        button(config.quiz.result.cta, 'btn btn-ink', () => {
          setLeadContext({
            formId: 'main',
            context,
            summary: fill(config.quiz.summary, { course, perWeek }),
            focus: true,
          });
        }),
        button(config.quiz.result.restart, 'option', restart),
      );
      optionsBox?.querySelector('button')?.focus({ preventScroll: true });
    };

    async function answer(step: StepId, value: string, label: string) {
      if (!started) {
        started = true;
        trackGoal('quiz_start');
      }
      answers = { ...answers, [step]: step === 'perWeek' ? Number(value) : value } as Answers;
      optionsBox?.replaceChildren();
      bubble(label, 'out');
      await typing();
      const next = nextStep(answers);
      if (next) {
        bubble(config.quiz.questions[next].text, 'in');
        showOptions(next);
      } else {
        showResult();
      }
    }

    function restart() {
      answers = {};
      log?.replaceChildren();
      bubble(config.quiz.greeting, 'in');
      bubble(config.quiz.questions.goal.text, 'in');
      showOptions('goal');
    }

    // Server HTML already shows the first question; only wire up the buttons, without stealing focus.
    showOptions('goal', false);
  }
</script>

<style is:global>
  .quiz-log {
    min-height: 15rem;
    max-height: 24rem;
    scroll-behavior: smooth;
  }
  .bubble {
    max-width: 85%;
    padding: 0.625rem 0.95rem;
    border-radius: var(--radius-bubble);
    line-height: 1.45;
  }
  .bubble-in {
    align-self: flex-start;
    border-bottom-left-radius: 0.375rem;
    background: var(--color-sky);
  }
  .bubble-out {
    align-self: flex-end;
    border-bottom-right-radius: 0.375rem;
    background: var(--color-ink);
    color: #fff;
  }
  .bubble-new {
    animation: bubble-in 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes bubble-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
  }
  .typing {
    display: flex;
    gap: 4px;
    padding-block: 0.875rem;
  }
  .typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-ink-soft);
    animation: typing 900ms infinite ease-in-out;
  }
  .typing span:nth-child(2) {
    animation-delay: 150ms;
  }
  .typing span:nth-child(3) {
    animation-delay: 300ms;
  }
  @keyframes typing {
    0%,
    80%,
    100% {
      opacity: 0.3;
    }
    40% {
      opacity: 1;
    }
  }
  .option {
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1.5px solid var(--color-ink);
    border-radius: 999px;
    background: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    transition:
      background-color 150ms ease,
      transform 150ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .option:hover {
    background: var(--color-sky);
  }
  .option:active {
    transform: scale(0.97);
  }
</style>
