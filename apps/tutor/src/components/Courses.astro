---
import Check from '@lucide/astro/icons/check';
import type { Page } from '../lib/content';
import { money } from '../lib/content';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const groups = page.audiences.map((audience) => ({
  ...audience,
  courses: page.courses.filter((course) => course.audience === audience.id),
}));
const choose = page.locale === 'ru' ? 'Записаться' : 'Choose';
---

<section id="courses" class="bg-sky/60" aria-labelledby="courses-title">
  <div class="wrap py-16 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="courses-title" class="section-title">
        {page.nav.courses}
      </h2>
      <p class="max-w-sm text-muted">{page.coursesMeta.packageNote}</p>
    </div>

    {groups.map((group) => (
      <div class="mt-12">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <h3 class="font-display text-2xl font-extrabold">{group.title}</h3>
          <p class="text-muted">{group.text}</p>
        </div>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {group.courses.map((course) => (
            <article class="flex flex-col rounded-[var(--radius-card)] bg-white p-6 shadow-card">
              <h4 class="font-display text-xl font-extrabold">{course.name}</h4>
              <p class="mt-1 text-sm text-muted">{course.format}</p>
              <p class="mt-4 flex items-baseline gap-1.5">
                <span class="font-display text-3xl font-extrabold tabular-nums">
                  {money(course.price, page.currency, page.locale)}
                </span>
                <span class="text-muted">{page.coursesMeta.priceSuffix}</span>
              </p>
              <ul class="mt-5 grid flex-1 content-start gap-2.5">
                {course.points.map((point) => (
                  <li class="flex gap-2.5">
                    <Check size={18} class="mt-1 flex-none text-good" aria-hidden="true" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
              <button
                type="button"
                class="btn btn-outline mt-6 self-start"
                data-course={course.name}
                aria-label={`${choose}: ${course.name}`}
              >
                {choose}
              </button>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { setLeadContext } from '@landings/ui/scripts/lead-context';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-course]')) {
    button.addEventListener('click', () => {
      const course = button.dataset.course ?? '';
      setLeadContext({
        formId: 'main',
        context: { source: 'Курсы', course },
        summary: course,
        focus: true,
      });
    });
  }
</script>
