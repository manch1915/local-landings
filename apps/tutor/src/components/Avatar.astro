---
interface Props {
  initials: string;
  size?: 'sm' | 'md';
}
const { initials, size = 'md' } = Astro.props;
---

<span
  class:list={[
    'grid flex-none place-items-center rounded-full bg-sticky font-display font-extrabold text-ink',
    size === 'sm' ? 'size-9 text-sm' : 'size-11 text-base',
  ]}
  aria-hidden="true"
>
  {initials}
</span>
