---
import { Image } from 'astro:assets';
import anna from '../assets/anna.jpg';

interface Props {
  size?: 'sm' | 'md';
}

const { size = 'md' } = Astro.props;
const px = size === 'sm' ? 36 : 44;
---

<Image
  src={anna}
  alt=""
  width={px}
  height={px}
  densities={[1, 2]}
  fit="cover"
  position="top"
  loading="eager"
  class:list={[
    'flex-none rounded-full bg-sticky object-cover',
    size === 'sm' ? 'size-9' : 'size-11',
  ]}
/>
