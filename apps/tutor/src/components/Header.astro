---
import type { Page } from '../lib/content';
import { href } from '../lib/content';
import Avatar from './Avatar.astro';

interface Props {
  page: Page;
  /** Path after the locale prefix for the language switch. */
  path?: string;
}

const { page, path = '' } = Astro.props;
const other = page.locale === 'ru' ? 'en' : 'ru';
// Anchors point at the home page, so the header also works on /privacy/ and 404.
const home = href(page.locale);
const links = [
  { href: `${home}#courses`, label: page.nav.courses },
  { href: `${home}#lessons`, label: page.nav.lessons },
  { href: `${home}#reviews`, label: page.nav.reviews },
  { href: `${home}#faq`, label: page.nav.faq },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-paper">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href={href(page.locale)} class="flex items-center gap-2.5 rounded-full">
      <span class="hidden min-[380px]:contents">
        <Avatar size="sm" />
      </span>
      <span class="leading-tight">
        <span class="block font-display text-[0.9375rem] font-extrabold whitespace-nowrap sm:text-base">
          {page.site.name}
        </span>
        <span class="hidden text-xs text-muted sm:block">{page.site.role}</span>
      </span>
    </a>
    <nav aria-label={page.locale === 'ru' ? 'Разделы' : 'Sections'} class="hidden lg:block">
      <ul class="flex gap-7 text-[0.9375rem] font-medium">
        {links.map((link) => (
          <li>
            <a href={link.href} class="py-2 text-ink-soft transition-colors hover:text-ink">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={href(other, path)}
        hreflang={other}
        aria-label={page.nav.langSwitch}
        lang={other}
        class="rounded-full px-2 py-2 text-sm font-semibold text-ink-soft hover:bg-sky sm:px-3"
      >
        <span class="sm:hidden">{other.toUpperCase()}</span>
        <span class="hidden sm:inline">{page.nav.langSwitch}</span>
      </a>
      <a
        href={`${home}#lead`}
        class="btn btn-ink min-h-11 px-3.5 text-[0.9375rem] whitespace-nowrap sm:px-4"
      >
        {page.nav.cta}
      </a>
    </div>
  </div>
</header>
