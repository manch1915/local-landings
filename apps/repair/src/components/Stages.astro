---
import type { Page } from '../lib/content';

interface Props {
  stages: Page['stages'];
  promises: Page['promises'];
}

const { stages, promises } = Astro.props;
---

<section id="stages" class="graph-paper border-y border-line" aria-labelledby="stages-title">
  <div class="wrap py-16 md:py-24">
    <h2 id="stages-title" class="section-title max-w-2xl">
      Как идёт ремонт
    </h2>

    <ol class="stages mt-12 grid gap-8 md:grid-cols-5 md:gap-6">
      {stages.map((stage, index) => (
        <li class="relative">
          <div class="flex items-center gap-3">
            <span class="num grid size-10 flex-none place-items-center rounded-full border-2 border-graphite bg-paper font-semibold">
              {index + 1}
            </span>
            <span class="stage-line hidden h-px flex-1 bg-graphite md:block" aria-hidden="true" />
          </div>
          <h3 class="mt-4 text-lg font-semibold">{stage.title}</h3>
          <p class="num mt-1 text-sm font-medium text-pencil">{stage.time}</p>
          <p class="mt-3 leading-relaxed text-muted">{stage.text}</p>
        </li>
      ))}
    </ol>

    <div class="mt-16 grid gap-px overflow-hidden rounded-sm border border-line bg-line sm:grid-cols-2">
      {promises.map((promise) => (
        <div class="bg-paper p-6 sm:p-8">
          <h3 class="text-lg font-semibold">{promise.title}</h3>
          <p class="mt-2 leading-relaxed text-muted">{promise.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stages li:last-child .stage-line {
    display: none;
  }
</style>
