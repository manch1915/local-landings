---
import Logo from './Logo.astro';

interface Props {
  legalName: string;
}

const { legalName } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = 2026;
---

<footer class="border-t border-graphite-soft bg-graphite text-[#c9c6bf]">
  <div class="wrap grid gap-6 py-10 text-sm md:grid-cols-[auto_1fr_auto] md:items-center md:gap-10">
    <Logo class="text-paper" />
    <p>
      © {year} {legalName.endsWith('.') ? legalName : `${legalName}.`}{' '}
      <a href={`${base}/privacy/`} class="underline underline-offset-2 hover:text-paper">
        Политика конфиденциальности
      </a>
    </p>
    <p class="max-w-sm md:text-right">
      Разработка сайта:{' '}
      <a href="https://narcisbin.com" class="text-paper underline underline-offset-2">
        Левон Оганесян
      </a>
    </p>
  </div>
</footer>
