---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2 font-semibold tracking-tight', className]}>
  <svg viewBox="0 0 24 32" class="h-7 w-auto" aria-hidden="true">
    <path d="M12 1v11" stroke="currentColor" stroke-width="2" />
    <circle cx="12" cy="2.5" r="1.5" fill="currentColor" />
    <path d="M6 12h12l-6 18z" fill="var(--color-level)" stroke="currentColor" stroke-width="1.5" />
  </svg>
  <span class="text-xl">Отвес</span>
</span>
