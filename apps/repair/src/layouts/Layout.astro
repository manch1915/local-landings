---
import '@fontsource-variable/geologica';
import fontCyrillic from '@fontsource-variable/geologica/files/geologica-cyrillic-wght-normal.woff2?url';
import Analytics from '@landings/ui/components/Analytics.astro';
import Seo from '@landings/ui/components/Seo.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogAlt: string;
  noindex?: boolean;
}

const { title, description, ogAlt, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fontCyrillic} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <Seo
      title={title}
      description={description}
      image={`${base}/og.png`}
      imageAlt={ogAlt}
      siteName="Отвес"
      themeColor="#2a2e33"
      noindex={noindex}
    />
    <slot name="head" />
    <Analytics
      umamiSrc={import.meta.env.PUBLIC_UMAMI_SRC}
      umamiId={import.meta.env.PUBLIC_UMAMI_ID}
      ymId={import.meta.env.PUBLIC_YM_ID}
    />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-level focus:px-4 focus:py-2 focus:font-semibold"
    >
      К содержанию
    </a>
    <slot />
  </body>
</html>
