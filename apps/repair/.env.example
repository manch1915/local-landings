# Public URL of the deployed site, used for canonical links, OG and sitemap.
SITE_URL=https://remont.narcisbin.com
# Set when the site lives under a path, e.g. /demo/remont/
BASE_PATH=/
# Dev only: where the Vite dev server proxies /api.
LEADS_API_URL=http://localhost:8787

# Analytics (optional). Umami: tracker URL and website id. Yandex Metrika: counter id.
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_ID=
PUBLIC_YM_ID=
