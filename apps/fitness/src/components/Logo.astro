---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]}>
  <svg viewBox="0 0 32 32" class="size-8" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="var(--color-tangerine)" />
    <path
      d="M9 7v18M9 16l9-9M12.5 13l8 12"
      stroke="var(--color-plum)"
      stroke-width="3.5"
      stroke-linecap="round"
      fill="none"
    ></path>
  </svg>
  <span class="font-display text-lg font-extrabold tracking-tight">Каденс</span>
</span>
