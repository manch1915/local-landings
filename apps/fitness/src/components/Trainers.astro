---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import artem from '../assets/artem.jpg';
import ilya from '../assets/ilya.jpg';
import marina from '../assets/marina.jpg';
import type { Page } from '../lib/content';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const photos: Record<Page['trainers'][number]['id'], ImageMetadata> = { ilya, marina, artem };
---

<section id="trainers" class="bg-plum text-white" aria-labelledby="trainers-title">
  <div class="wrap py-16 md:py-24">
    <h2 id="trainers-title" class="section-title">
      Тренеры
    </h2>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {page.trainers.map((trainer) => (
        <article class="rounded-2xl bg-plum-soft p-3 pb-6">
          <Picture
            src={photos[trainer.id]}
            formats={['avif', 'webp']}
            widths={[320, 480, 640]}
            sizes="(min-width: 768px) 30vw, 100vw"
            alt={`${trainer.name}, тренер студии`}
            class="aspect-[4/5] w-full rounded-xl object-cover object-top"
          />
          <h3 class="mt-5 px-3 font-display text-xl font-extrabold">{trainer.name}</h3>
          <p class="mt-1 px-3 font-semibold text-sun">{trainer.role}</p>
          <p class="mt-3 px-3 text-powder">{trainer.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
