---
import type { Page } from '../lib/content';
import { rub } from '../lib/content';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const { plans } = page;
---

<section id="plans" class="wrap py-16 md:py-24" aria-labelledby="plans-title">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 id="plans-title" class="section-title">
      {plans.title}
    </h2>
    <p class="max-w-sm text-muted">{plans.lead}</p>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {plans.items.map((plan) => (
      <article
        class:list={[
          'flex flex-col rounded-2xl border-2 p-6',
          plan.featured ? 'border-tangerine bg-tangerine' : 'border-plum',
        ]}
      >
        <h3 class="font-display text-xl font-extrabold">{plan.name}</h3>
        <p class="mt-1 text-sm">{plan.unit}</p>
        <p class="mt-6 font-display text-4xl font-extrabold tracking-tight tabular-nums">
          {rub(plan.price)}
        </p>
        <p class:list={['mt-2 flex-1', !plan.featured && 'text-muted']}>{plan.note}</p>
        <button
          type="button"
          class:list={['btn mt-6', plan.featured ? 'btn-plum' : 'btn-line']}
          data-plan={`${plan.name}, ${rub(plan.price)}`}
          aria-label={`${plans.choose}: ${plan.name}`}
        >
          {plans.choose}
        </button>
      </article>
    ))}
  </div>

  <div class="mt-4 grid gap-4 md:grid-cols-2">
    {plans.extras.map((extra, index) => (
      <div class:list={['rounded-2xl p-6', index === 0 ? 'bg-plum text-white' : 'bg-powder']}>
        <h3 class="font-display text-lg font-extrabold">{extra.title}</h3>
        <p class:list={['mt-2', index === 0 ? 'text-powder' : 'text-muted']}>{extra.text}</p>
      </div>
    ))}
  </div>
</section>

<script>
  import { setLeadContext } from '@landings/ui/scripts/lead-context';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-plan]')) {
    button.addEventListener('click', () => {
      const plan = button.dataset.plan ?? '';
      setLeadContext({
        formId: 'main',
        context: { source: 'Абонементы', plan },
        summary: `Абонемент: ${plan}`,
        focus: true,
      });
    });
  }
</script>
