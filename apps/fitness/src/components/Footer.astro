---
import Logo from './Logo.astro';

interface Props {
  legalName: string;
}

const { legalName } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = 2026;
---

<footer class="border-t border-plum-soft bg-plum text-powder">
  <div class="wrap grid gap-6 py-10 text-sm md:grid-cols-[auto_1fr_auto] md:items-center md:gap-10">
    <Logo class="text-white" />
    <p>
      © {year} {legalName}.{' '}
      <a href={`${base}/privacy/`} class="underline underline-offset-2 hover:text-white">
        Политика конфиденциальности
      </a>
    </p>
    <p class="max-w-sm md:text-right">
      Демо-проект: студия, тренеры и контакты вымышлены. Разработка:
      <a href="https://narcisbin.com" class="text-white underline underline-offset-2">
        Левон Оганесян
      </a>
    </p>
  </div>
</footer>
