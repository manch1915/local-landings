---
import type { Page } from '../lib/content';

interface Props {
  page: Page;
}

const { page } = Astro.props;
---

<section id="directions" class="wrap py-16 md:py-24" aria-labelledby="directions-title">
  <h2 id="directions-title" class="section-title max-w-3xl">
    Четыре направления, одна студия
  </h2>
  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    {page.directions.map((direction) => (
      <article
        class:list={[
          'flex min-h-64 flex-col justify-between gap-8 rounded-2xl bg-(--dir) p-6 text-(--dir-ink) sm:p-8',
          `dir-${direction.id}`,
        ]}
      >
        <h3 class="font-display text-[clamp(1.375rem,6.4vw,2.25rem)] leading-none font-extrabold tracking-tight">
          {direction.name}
        </h3>
        <div>
          <p class="max-w-[40ch] text-lg">{direction.text}</p>
          <p class="mt-3 text-sm font-bold">{direction.level}</p>
        </div>
      </article>
    ))}
  </div>
</section>
