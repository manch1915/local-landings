---
interface Props {
  lat: number;
  lon: number;
  zoom?: number;
  /** Shown on the button and used as the iframe title. */
  label: string;
  address: string;
  class?: string;
}

const { lat, lon, zoom = 16, label, address, class: className = '' } = Astro.props;

// The Yandex widget weighs ~1 MB, so it loads only when someone asks for the map.
const src = `https://yandex.ru/map-widget/v1/?ll=${lon}%2C${lat}&z=${zoom}&pt=${lon}%2C${lat}%2Cpm2rdm`;
const external = `https://yandex.ru/maps/?pt=${lon},${lat}&z=${zoom}&l=map`;
---

<div class:list={['map-facade', className]} data-map-src={src} data-map-title={address}>
  <div class="map-facade-art" aria-hidden="true">
    <slot />
  </div>
  <div class="map-facade-actions">
    <button type="button" class="map-facade-button" data-map-load>
      {label}
    </button>
    <a class="map-facade-link" href={external} target="_blank" rel="noopener">
      Яндекс Карты
    </a>
  </div>
</div>

<script>
  for (const facade of document.querySelectorAll<HTMLElement>('[data-map-src]')) {
    facade.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = facade.dataset.mapSrc ?? '';
      frame.title = facade.dataset.mapTitle ?? 'Map';
      frame.loading = 'lazy';
      frame.allowFullscreen = true;
      frame.className = 'map-facade-frame';
      facade.replaceChildren(frame);
      facade.dataset.loaded = 'true';
    });
  }
</script>

<style is:global>
  .map-facade {
    position: relative;
    overflow: hidden;
  }
  .map-facade-art {
    position: absolute;
    inset: 0;
  }
  .map-facade-actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .map-facade-frame {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    border: 0;
  }
</style>
