---
interface Props {
  lat: number;
  lon: number;
  zoom?: number;
  /** Shown on the button and used as the iframe title. */
  label: string;
  address: string;
  externalLabel?: string;
  /** Shown when the embedded map does not load, e.g. blocked by the browser. */
  failedText?: string;
  class?: string;
}

const {
  lat,
  lon,
  zoom = 16,
  label,
  address,
  externalLabel = 'Открыть в Яндекс Картах',
  failedText = 'Карта не загрузилась. Возможно, её блокирует браузер.',
  class: className = '',
} = Astro.props;

// The Yandex widget weighs ~1 MB, so it loads only when someone asks for the map.
const src = `https://yandex.ru/map-widget/v1/?ll=${lon}%2C${lat}&z=${zoom}&pt=${lon}%2C${lat}%2Cpm2rdm`;
const external = `https://yandex.ru/maps/?pt=${lon},${lat}&z=${zoom}&l=map`;
---

<div
  class:list={['map-facade', className]}
  data-map-src={src}
  data-map-title={address}
  data-state="idle"
>
  <div class="map-facade-art" aria-hidden="true">
    <slot />
  </div>
  <div class="map-facade-actions">
    <button type="button" class="map-facade-button" data-map-load>
      {label}
    </button>
    <a class="map-facade-link" href={external} target="_blank" rel="noopener">
      {externalLabel}
    </a>
    <p class="map-facade-failed" role="status">
      {failedText}
    </p>
  </div>
</div>

<script>
  // If the frame never fires "load" (blocked by an extension, strict tracking
  // protection, no access to Yandex), fall back to the link instead of a blank box.
  const TIMEOUT_MS = 8000;

  for (const facade of document.querySelectorAll<HTMLElement>('[data-map-src]')) {
    const button = facade.querySelector<HTMLButtonElement>('[data-map-load]');
    button?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.title = facade.dataset.mapTitle ?? 'Map';
      frame.allowFullscreen = true;
      frame.className = 'map-facade-frame';

      const timer = window.setTimeout(() => {
        facade.dataset.state = 'failed';
        frame.remove();
      }, TIMEOUT_MS);
      frame.addEventListener('load', () => {
        window.clearTimeout(timer);
        facade.dataset.state = 'loaded';
      });

      facade.dataset.state = 'loading';
      facade.dataset.loaded = 'true';
      frame.src = facade.dataset.mapSrc ?? '';
      facade.append(frame);
    });
  }
</script>

<style is:global>
  .map-facade {
    position: relative;
    overflow: hidden;
  }
  .map-facade-art {
    position: absolute;
    inset: 0;
  }
  .map-facade-actions {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .map-facade-frame {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map-facade-failed {
    flex-basis: 100%;
    display: none;
    color: #fff;
    font-weight: 500;
  }

  /* While loading and after: the button is gone, the link stays as a chip over the map. */
  .map-facade:not([data-state='idle']) .map-facade-button {
    display: none;
  }
  .map-facade[data-state='loading'] .map-facade-actions,
  .map-facade[data-state='loaded'] .map-facade-actions {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    width: auto;
    max-width: calc(100% - 1.5rem);
    margin: 0;
    padding: 0;
  }
  .map-facade[data-state='loading'] .map-facade-link,
  .map-facade[data-state='loaded'] .map-facade-link,
  .map-facade[data-state='failed'] .map-facade-link {
    padding: 0.5rem 0.875rem;
    border-radius: 999px;
    background: #fff;
    color: #1d1d1f;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.2);
  }
  .map-facade[data-state='failed'] .map-facade-failed {
    display: block;
  }
</style>
