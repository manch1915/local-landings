PORT=8787
# Behind nginx/Caddy: take the client IP from X-Forwarded-For.
TRUST_PROXY=true

# Telegram: bot from @BotFather, chat id of the manager or group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CRM: mock | amocrm | bitrix24
CRM_PROVIDER=mock
# amoCRM: account subdomain and a long-lived token of a private integration.
AMOCRM_SUBDOMAIN=
AMOCRM_TOKEN=
AMOCRM_PIPELINE_ID=
# Bitrix24: incoming webhook with the crm scope, e.g. https://example.bitrix24.ru/rest/1/abc123/
BITRIX24_WEBHOOK_URL=

# Anti-spam
RATE_LIMIT_PER_10_MIN=5
# All leads of one site, protects Telegram from floods.
SITE_LIMIT_PER_10_MIN=60
MIN_FILL_MS=2500
