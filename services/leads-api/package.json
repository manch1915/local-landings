{
  "name": "@landings/leads-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.js --packages=bundle --minify --sourcemap --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/server.js",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@landings/leads": "*",
    "hono": "^4.13.13",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
